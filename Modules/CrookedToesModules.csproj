<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latestmajor</LangVersion>
    <WindowsSdkPackageVersion>10.0.26100.1</WindowsSdkPackageVersion>
    <SupportedOSPlatform>windows10.0.22621.0</SupportedOSPlatform>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <VrcOscLocalPackageDirectory>$(APPDATA)\VRCOSC\packages\local</VrcOscLocalPackageDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" GeneratePathProperty="true" />
    <PackageReference Include="NWaves" Version="0.9.6" GeneratePathProperty="true" />
    <PackageReference Include="VolcanicArts.VRCOSC.SDK" Version="2026.501.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime.dll"
                      LogicalName="CrookedToe.Native.onnxruntime.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime_providers_shared.dll"
                      LogicalName="CrookedToe.Native.onnxruntime_providers_shared.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Leashcode\**" />
    <None Remove="VRCOSC-Modules\**" />
    <Compile Remove="Leashcode\**" />
    <Compile Remove="VRCOSC-Modules\**" />
    <Page Remove="VRCOSC-Modules\**" />
    <EmbeddedResource Remove="Leashcode\**" />
    <EmbeddedResource Remove="VRCOSC-Modules\**" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent"
          Condition="'$(CI)' != 'true' and Exists('$(VrcOscLocalPackageDirectory)')">
    <Exec Command="copy /Y &quot;$(TargetDir)$(TargetName).dll&quot; &quot;$(VrcOscLocalPackageDirectory)\$(TargetName).dll&quot;" />
    <Exec Command="copy /Y &quot;$(TargetDir)NWaves.dll&quot; &quot;$(VrcOscLocalPackageDirectory)\NWaves.dll&quot;" />
    <Exec Command="copy /Y &quot;$(TargetDir)Microsoft.ML.OnnxRuntime.dll&quot; &quot;$(VrcOscLocalPackageDirectory)\Microsoft.ML.OnnxRuntime.dll&quot;" />
  </Target>

</Project>
